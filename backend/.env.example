# ==========================================
# Portfolio Backend Configuration
# ==========================================

# Server Port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# SMTP Email Configuration (Nodemailer)
# ==========================================
# Supported providers: Gmail, Outlook, Yahoo, or custom SMTP server
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your email address that sends the emails
SMTP_USER=patilsayali330@gmail.com

# Your SMTP App Password:
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter 'Portfolio' as the app name and copy the 16-character password here (without spaces)
SMTP_PASS=your-16-digit-app-password

# Email address that receives the contact form inquiries (can be same as SMTP_USER)
RECEIVER_EMAIL=patilsayali330@gmail.com
